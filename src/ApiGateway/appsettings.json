{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "payment-processing-route": {
        "ClusterId": "payment-processing-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/payments/{**catch-all}"
          }
        ]
      },
      "risk-assessment-route": {
        "ClusterId": "risk-assessment-cluster",
        "Match": {
          "Path": "/api/risk/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/risk/{**catch-all}"
          }
        ]
      },
      "payment-router-route": {
        "ClusterId": "payment-router-cluster",
        "Match": {
          "Path": "/api/router/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/router/{**catch-all}"
          }
        ]
      },
      "bank-adapter-route": {
        "ClusterId": "bank-adapter-cluster",
        "Match": {
          "Path": "/api/bank/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/bank/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "payment-processing-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "payment-processing.default.svc.cluster.local:8080"
          }
        },
        "HealthCheck": {
          "Active": {
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "risk-assessment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "risk-assessment.default.svc.cluster.local:8080"
          }
        },
        "HealthCheck": {
          "Active": {
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "payment-router-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "payment-router.default.svc.cluster.local:8080"
          }
        },
        "HealthCheck": {
          "Active": {
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "bank-adapter-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "bank-adapter.default.svc.cluster.local:8080"
          }
        },
        "HealthCheck": {
          "Active": {
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      }
    }
  },
  "ServiceName": "ApiGateway",
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector.monitoring.svc.cluster.local:4317"
  }
}