{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "__secret__"
  },
  "IdentityServer": {
    "Key": {
      "Type": "Production",
      "FilePath": "/etc/identityserver/certificate.pfx",
      "Password": "${CERTIFICATE_PASSWORD}"
    }
  }
}